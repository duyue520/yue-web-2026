# ============================================================
#  越的网站 · 后端环境变量示例（复制为 /opt/wb-api/.env 并填值）
#  ⚠️ 本文件只含占位符；真实 .env 永不入库
#  ⚠️ 值里含 | 必须加双引号（systemd EnvironmentFile 与 shell source 双兼容）
# ============================================================

# ---------- 必填 ----------
# PostgreSQL 连接串（SQLAlchemy + psycopg 驱动）
DATABASE_URL=postgresql+psycopg://wbuser:换成强密码@127.0.0.1:5432/wb_campus

# JWT / 会话签名密钥，务必随机生成：
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=请替换为随机字符串

# 服务端口（nginx 反代到它）
PORT=7860

# 跨域白名单（逗号分隔；生产环境写站点域名，勿用 *）
CORS_ORIGINS=https://heyiwei.tech

# 病害识别推理后端：onnx（推荐，无需 torch）或 torch
PREDICT_BACKEND=onnx

# ---------- AI 网关 / 分身 ----------
# 网关内部回环地址（分身会经由本机网关调用上游）
AI_DOUBAO_BASE=http://127.0.0.1:7860/v1
# 网关内部系统密钥（sk-wb- 开头，需在 ai_keys 表里存在并 enabled=true；被禁用会自动自愈）
AI_DOUBAO_KEY=sk-wb-请替换
# 上游模型名（与 ai_upstreams.models 对应）
AI_DOUBAO_MODEL=doubao-web
# 上游超时（秒）
AI_TIMEOUT=120
# 管理端密钥（访问 /api/ai-gw/* 管理接口用，随机生成）
AI_GW_ADMIN_TOKEN=请替换为随机字符串

# ---------- 音乐（可选） ----------
# 自建解析器池：名称|模板，{id}/{level} 为占位符；多个用英文逗号分隔
# MUSIC_RESOLVERS="自建|https://example.com/play?id={id}&level={level}"

# ---------- 其它（可选） ----------
# 时区
TZ=Asia/Shanghai
